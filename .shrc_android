function adb_filterproc {
    adb shell ps | fzf -e | awk '{print $2}'
}

function adb_getproc {
    # adb shell ps | grep $1 | awk '{print $2}'
    qpid | fzf | awk {'print $1'}
}

function adb_kill {
    qpid | fzf | awk {'print $1'}  | xargs adb shell kill
}

function adb_launch {
    # $1 = package id
	# $2 = activity id
	adb shell am start -n $1/$2
}

function adbkl {
    adb_kill $1
    adb_launch $1 $2
}

function aosdev {
    cd $HOME/aos-mirror
    source build/envsetup.sh
    set_stuff_for_environment
}

function adbsr {
    # screenrecord
    # $1 = filename
    # press ctrl+c to stop
    ABS_PATH="/sdcard/$1"
    adb shell screenrecord $ABS_PATH
    adb pull $ABS_PATH
    adb shell rm $ABS_PATH
}

alias studio="android-studio-canary"
alias ass="adb sync && adb shell sync"

# DE Bits (need to clean up this section)

alias dumpde="adb shell getprop | grep deconfig"
alias dedump="dumpde"

alias filterde="dumpde | fzf"

function debits {
    # Pick and set the value of any currently set DE bit
    PROP=$(filterde | awk '{ print substr($1, 2, length($1) - 3) }')

    VALUE=""
    echo "Enter desired value for $PROP:"
    read VALUE

    adb shell setprop $PROP $VALUE
}

function deset {
    # Pick and set any valid DE bit
    DE_FILE="$AOSP_HOME/vendor/ford/hardware/vehicle/deservice/sysprop/DeConfigurationProperties.sysprop"

    PROP=$(cat $DE_FILE | grep deconfig | fzf | awk -F\" '{print $2}')

    VALUE=""
    echo "Enter desired value for $PROP:"
    read VALUE

    adb shell setprop $PROP $VALUE
}

function deget {
    # Get the value of any valid DE bit
    DE_FILE="$AOSP_HOME/vendor/ford/hardware/vehicle/deservice/sysprop/DeConfigurationProperties.sysprop"

    PROP=$(cat $DE_FILE | grep deconfig | fzf | awk -F\" '{print $2}')

    adb shell getprop $PROP $VALUE
}
